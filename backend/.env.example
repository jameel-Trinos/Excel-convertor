# Upload and output directories
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# File size limit (in bytes, default: 50MB)
MAX_FILE_SIZE=52428800

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI Features (Optional but recommended for best results)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: OpenAI as fallback
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-openai-key-here

# Azure Document Intelligence (for voter list extraction)
# Create resource at: https://portal.azure.com → Document Intelligence
# AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DI_KEY=your-key-here
# Prefer Azure DI over PaddleOCR for PDFs with more than N pages (0 = disabled)
# AZURE_DI_LARGE_PDF_PAGES=15
